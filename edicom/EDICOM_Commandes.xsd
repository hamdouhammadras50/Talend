<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema XSD du flux quotidien des commandes vers EDICOM (job Talend EDICOM_Commandes_XML).
  Structure : Commandes / Commande (1..n) / Entete (1) + Lignes / Ligne (1..n).
  Toutes les balises sont toujours presentes, dans l'ordre impose.

  Descriptions et obligations : tableau des champs fourni par EDICOM (colonne "obligatoire").
    - Champ obligatoire : la balise doit contenir une valeur (balise vide refusee).
    - Champ facultatif  : la balise peut etre vide (<X/>), valeur NULL en base.
  Types et longueurs : repris des tables sources APPRODIRECT.COMMANDE_ENVOI (Entete)
  et APPRODIRECT.ARTICLE_COMMANDE_ENVOI (Ligne).

  Regle non exprimable en XSD 1.0 (a garantir par la requete d'extraction) :
    dans chaque <Ligne>, I_EAN ou CODE_ARTICLE_FOURN_CMDE doit etre renseigne.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="Commandes">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Commande" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Entete">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="CODE_CMDE" type="tNombre12_0"><xs:annotation><xs:documentation>Unique purchase order number | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.CODE_CMDE - NUMBER(12,0) - NOT NULL</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="CODE_PDV_FOURN" type="tTexte50_O"><xs:annotation><xs:documentation>Our customer code assigned by the supplier. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.CODE_PDV_FOURN - VARCHAR2(50 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="I_PDV" type="tTexte50_O"><xs:annotation><xs:documentation>Not required. Internal code of the store/location to be delivered. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.I_PDV - VARCHAR2(50 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="NUMERO_CMDE" type="tTexte100_O"><xs:annotation><xs:documentation>Unique purchase order number | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.NUMERO_CMDE - VARCHAR2(100 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="TYPE_CMDE" type="tTexte6_O"><xs:annotation><xs:documentation>CMDE (Hardcoded) | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.TYPE_CMDE - VARCHAR2(6 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="DATE_LIVRAISON_CMDE" type="tDate"><xs:annotation><xs:documentation>Delivery date of the goods | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.DATE_LIVRAISON_CMDE - DATE - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="CODE_ERP1_FOURN" type="tTexte100_O"><xs:annotation><xs:documentation>Not required. Our internal supplier number. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.CODE_ERP1_FOURN - VARCHAR2(100 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="ENVOYEE_CMDE" type="tNombre12_0"><xs:annotation><xs:documentation>Flag updated after order processing. Always set to -1. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.ENVOYEE_CMDE - NUMBER(12,0) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="DATE_ENVOI_CMDE" type="tDateHeure_Vide"><xs:annotation><xs:documentation>Timestamp of the upstream order processing. | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.DATE_ENVOI_CMDE - DATE - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="EMAIL_CMDES_FOURN" type="tTexte100"><xs:annotation><xs:documentation>Not required. Email address used to send the purchase order to the supplier. | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.EMAIL_CMDES_FOURN - VARCHAR2(100 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="LIBELLE_SITE" type="tTexte150_O"><xs:annotation><xs:documentation>Name of the store or delivery location. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.LIBELLE_SITE - VARCHAR2(150 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="ADRESSE_SITE" type="tTexte514"><xs:annotation><xs:documentation>Delivery address. | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.ADRESSE_SITE - VARCHAR2(514 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="TELEPHONE_SITE" type="tTexte20"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.TELEPHONE_SITE - VARCHAR2(20 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="ADRESSE_LIVRAISON" type="tTexte514"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.ADRESSE_LIVRAISON - VARCHAR2(514 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="NOM_UTILISATEUR" type="tTexte100_O"><xs:annotation><xs:documentation>Last name of the person responsible for the store or delivery location. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.NOM_UTILISATEUR - VARCHAR2(100 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="PRENOM_UTILISATEUR" type="tTexte100_O"><xs:annotation><xs:documentation>First name of the person responsible for the store or delivery location. | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.PRENOM_UTILISATEUR - VARCHAR2(100 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="CODE_FOURN" type="tNombre12_0"><xs:annotation><xs:documentation>Supplier identification code (internal) | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.CODE_FOURN - NUMBER(12,0) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="RAISON_SOCIALE_FOURN" type="tTexte300_O"><xs:annotation><xs:documentation>Supplier name | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.RAISON_SOCIALE_FOURN - VARCHAR2(300 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="DATE_CMDE" type="tDate"><xs:annotation><xs:documentation>Order issue date | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.DATE_CMDE - DATE - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="TOTAL_CMDE" type="tNombre19_5_Vide"><xs:annotation><xs:documentation>Order total amount | Obligatoire EDICOM : non | Source : COMMANDE_ENVOI.TOTAL_CMDE - NUMBER(19,5) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="I_GLN_PDV" type="tTexte13_O"><xs:annotation><xs:documentation>GLN of the store/location to be delivered | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.I_GLN_PDV - VARCHAR2(13 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                    <xs:element name="I_GLN_DESTINATAIRE_DE_CMDE" type="tTexte13_O"><xs:annotation><xs:documentation>Supplier&apos;s GLN | Obligatoire EDICOM : oui | Source : COMMANDE_ENVOI.I_GLN_DESTINATAIRE_DE_CMDE - VARCHAR2(13 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Lignes">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Ligne" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="CODE_CMDE_1" type="tNombre12_0"><xs:annotation><xs:documentation>Same as CODE_CMDE | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.CODE_CMDE - NUMBER(12,0) - NOT NULL</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="CODE_ARTICLE_FOURN_CMDE" type="tTexte20"><xs:annotation><xs:documentation>Supplier&apos;s item reference. Either I_EAN or CODE_ARTICLE_FOURN_CMDE must be provided. | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.CODE_ARTICLE_FOURN_CMDE - VARCHAR2(20 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="CODE_ERP1_ARTICLE" type="tTexte30_O"><xs:annotation><xs:documentation>Internal item code | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.CODE_ERP1_ARTICLE - VARCHAR2(30 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="QUANTITE_ARTICLE_CMDE" type="tNombre15_3"><xs:annotation><xs:documentation>Ordered quantity | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.QUANTITE_ARTICLE_CMDE - NUMBER(15,3) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="TARIF_ARTICLE_CMDE" type="tNombre19_5"><xs:annotation><xs:documentation>Unit price | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.TARIF_ARTICLE_CMDE - NUMBER(19,5) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="CODE_ERP1_UNITE_CONSOMMATION" type="tTexte30_O"><xs:annotation><xs:documentation>Order unit of measure | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.CODE_ERP1_UNITE_CONSOMMATION - VARCHAR2(30 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="LIBELLE_FAMILLE" type="tTexte160_O"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.LIBELLE_FAMILLE - VARCHAR2(160 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="LIBELLE_ARTICLE_CMDE" type="tTexte800_O"><xs:annotation><xs:documentation>Item description | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.LIBELLE_ARTICLE_CMDE - VARCHAR2(800 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="LIBELLE_UNITE_ACHAT" type="tTexte30_O"><xs:annotation><xs:documentation>Description of the purchase unit (number of units per order unit) | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.LIBELLE_UNITE_ACHAT - VARCHAR2(30 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="TOTAL_ARTICLE_CMDE" type="tNombre19_5_Vide"><xs:annotation><xs:documentation>Line total amount (EUR) | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.TOTAL_ARTICLE_CMDE - NUMBER(19,5) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="CODE_ARTICLE" type="tNombre12_0"><xs:annotation><xs:documentation>Same as CODE_ERP1_ARTICLE | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.CODE_ARTICLE - NUMBER(12,0) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="PRIX_VENTE_ARTICLE_CMDE" type="tNombre15_5_Vide"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.PRIX_VENTE_ARTICLE_CMDE - NUMBER(15,5) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="PCB_ARTICLE_CMDE" type="tNombre12_0"><xs:annotation><xs:documentation>Number of units per purchase unit | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.PCB_ARTICLE_CMDE - NUMBER(12,0) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="I_LIGNE_CMDE" type="tNombre8_0"><xs:annotation><xs:documentation>Line number | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.I_LIGNE_CMDE - NUMBER(8,0) - NOT NULL</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="I_EAN" type="tTexte13"><xs:annotation><xs:documentation>Item EAN code. Either I_EAN or CODE_ARTICLE_FOURN_CMDE must be provided. | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.I_EAN - VARCHAR2(13 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="N_MULTIPLE_COMMANDE" type="tNombre8_3"><xs:annotation><xs:documentation>Order multiple quantity | Obligatoire EDICOM : oui | Source : ARTICLE_COMMANDE_ENVOI.N_MULTIPLE_COMMANDE - NUMBER(8,3) - NOT NULL</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="I_OPERATION" type="tNombre6_0_Vide"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.I_OPERATION - NUMBER(6,0) - nullable</xs:documentation></xs:annotation></xs:element>
                          <xs:element name="L_OPERATION" type="tTexte40"><xs:annotation><xs:documentation>Not required. | Obligatoire EDICOM : non | Source : ARTICLE_COMMANDE_ENVOI.L_OPERATION - VARCHAR2(40 BYTE) - nullable</xs:documentation></xs:annotation></xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
          <!-- Un numero de ligne n'apparait qu'une fois par commande -->
          <xs:unique name="LigneUniqueParCommande">
            <xs:selector xpath="Lignes/Ligne"/>
            <xs:field xpath="I_LIGNE_CMDE"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <!-- Une commande n'apparait qu'une fois dans le fichier -->
    <xs:unique name="CommandeUnique">
      <xs:selector xpath="Commande/Entete"/>
      <xs:field xpath="CODE_CMDE"/>
    </xs:unique>
  </xs:element>

  <xs:simpleType name="tVide">
    <xs:annotation><xs:documentation>Balise vide (valeur NULL en base).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:length value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte6_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 6 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="6"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte13">
    <xs:annotation><xs:documentation>Texte facultatif : 13 caracteres maximum, balise vide autorisee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="13"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte13_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 13 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="13"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte20">
    <xs:annotation><xs:documentation>Texte facultatif : 20 caracteres maximum, balise vide autorisee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte30_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 30 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="30"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte40">
    <xs:annotation><xs:documentation>Texte facultatif : 40 caracteres maximum, balise vide autorisee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="40"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte50_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 50 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="50"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte100">
    <xs:annotation><xs:documentation>Texte facultatif : 100 caracteres maximum, balise vide autorisee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="100"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte100_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 100 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="100"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte150_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 150 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="150"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte160_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 160 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="160"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte300_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 300 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="300"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte514">
    <xs:annotation><xs:documentation>Texte facultatif : 514 caracteres maximum, balise vide autorisee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:maxLength value="514"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTexte800_O">
    <xs:annotation><xs:documentation>Texte obligatoire : 1 a 800 caracteres, balise vide refusee.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="800"/>
      <xs:pattern value=".*\S.*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre6_0">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(6,0) : 6 chiffres au total, dont 0 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:totalDigits value="6"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre6_0_Vide">
    <xs:annotation><xs:documentation>Nombre facultatif NUMBER(6,0) : nombre ou balise vide.</xs:documentation></xs:annotation>
    <xs:union memberTypes="tNombre6_0 tVide"/>
  </xs:simpleType>
  <xs:simpleType name="tNombre8_0">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(8,0) : 8 chiffres au total, dont 0 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:totalDigits value="8"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre8_3">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(8,3) : 8 chiffres au total, dont 3 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="8"/>
      <xs:fractionDigits value="3"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre12_0">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(12,0) : 12 chiffres au total, dont 0 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:totalDigits value="12"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre15_3">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(15,3) : 15 chiffres au total, dont 3 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="15"/>
      <xs:fractionDigits value="3"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre15_5">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(15,5) : 15 chiffres au total, dont 5 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="15"/>
      <xs:fractionDigits value="5"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre15_5_Vide">
    <xs:annotation><xs:documentation>Nombre facultatif NUMBER(15,5) : nombre ou balise vide.</xs:documentation></xs:annotation>
    <xs:union memberTypes="tNombre15_5 tVide"/>
  </xs:simpleType>
  <xs:simpleType name="tNombre19_5">
    <xs:annotation><xs:documentation>Nombre obligatoire NUMBER(19,5) : 19 chiffres au total, dont 5 decimales.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="19"/>
      <xs:fractionDigits value="5"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tNombre19_5_Vide">
    <xs:annotation><xs:documentation>Nombre facultatif NUMBER(19,5) : nombre ou balise vide.</xs:documentation></xs:annotation>
    <xs:union memberTypes="tNombre19_5 tVide"/>
  </xs:simpleType>
  <xs:simpleType name="tDate">
    <xs:annotation><xs:documentation>Date obligatoire au format AAAA-MM-JJ.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:date"/>
  </xs:simpleType>
  <xs:simpleType name="tDateHeure_Vide">
    <xs:annotation><xs:documentation>Date et heure facultatives, format AAAA-MM-JJ HH:MI:SS, ou balise vide.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01]) ([01]\d|2[0-3]):[0-5]\d:[0-5]\d)?"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
